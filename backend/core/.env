# Defaults for local runs outside Compose. Real environment variables win.
# No secret values here: passwords and APP_SECRET come from the environment (infra/.env through Compose).
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

DB_HOST=postgres
DB_PORT=5432
DB_NAME=locator
CORE_APP_PASSWORD=
CORE_MIGRATOR_PASSWORD=

SERVICE_NAME=core
LOG_LEVEL=info
OPERATOR_MODE=off
LOCATOR_PUBLIC_BASE_URL=http://localhost:8080
OPENAPI_CONTRACT_PATH=/contract/openapi.yaml
