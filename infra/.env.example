# Copy to infra/.env and fill in every empty value. Never commit infra/.env.
# Every name below must be present and non-empty in infra/.env (scripts/up.ps1 checks it).

COMPOSE_PROJECT_NAME=locator

# Host ports, bound to 127.0.0.1 only. Change them if another stack on this PC uses them.
LOCATOR_HTTP_PORT=8080
LOCATOR_DB_PORT=15432

# Base of the legal page links. If you change LOCATOR_HTTP_PORT, change the port here too.
LOCATOR_PUBLIC_BASE_URL=http://localhost:8080

# Local development passwords; any non-empty values work.
POSTGRES_PASSWORD=
CORE_MIGRATOR_PASSWORD=
CORE_APP_PASSWORD=
DELIVERY_APP_PASSWORD=

# Symfony secret: any long random string.
APP_SECRET=

LOG_LEVEL=info
OPERATOR_MODE=off
